{
  "name": "vatioclaro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "wrangler dev --config wrangler.jsonc",
    "preview": "wrangler dev --config wrangler.jsonc",
    "check:cloudflare": "wrangler deploy --dry-run --config wrangler.jsonc",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "test": "npm run test:unit && npm run build && npm run test:static",
    "test:unit": "node --experimental-strip-types --test tests/calculations.test.ts",
    "test:static": "node --test tests/site-output.test.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "pretest:e2e:ui": "npm run build",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern out --ignore-pattern .wrangler --ignore-pattern .vinext"
  },
  "dependencies": {
    "lucide-react": "1.44.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.131.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.0"
  },
  "type": "module"
}
